﻿@model List<WEB_APPLICATION.Models.Forum>
@{
    Layout = null;
    int courseId = ViewBag.CourseId != null ? (int)ViewBag.CourseId : 0;
    string role = Session["role"] != null ? Session["role"].ToString() : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EduNest - Course Forums</title>
    <link rel="stylesheet" href="~/Content/site.css" />
</head>
<body>

    <div class="dashboard-layout">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="sidebar-logo">
                <a class="nav-logo" href="@(Session["role"] != null && Session["role"].ToString() == "instructor" ? Url.Action("Dashboard", "Instructor") : Session["role"] != null && Session["role"].ToString() == "admin" ? Url.Action("Dashboard", "Admin") : Url.Action("MyEnrollments", "Enrollment"))" style="font-size:18px">
                    <img src="~/Uploads/logo.svg" alt="EduNest" class="nav-logo-icon" style="width:56px;height:56px" />EduNest
                </a>
            </div>
            <nav style="padding:8px 0">
                @if (role == "admin")
                {
                    <a class="sidebar-item" href="@Url.Action("Dashboard", "Admin")">
                        <span class="sidebar-icon">&#127968;</span>Dashboard
                    </a>
                }
                else if (role == "instructor")
                {
                    <a class="sidebar-item" href="@Url.Action("Dashboard", "Instructor")">
                        <span class="sidebar-icon">&#127968;</span>Dashboard
                    </a>
                }
                else
                {
                    <a class="sidebar-item" href="@Url.Action("MyEnrollments", "Enrollment")">
                        <span class="sidebar-icon">&#127968;</span>Dashboard
                    </a>
                }
                <a class="sidebar-item" href="@Url.Action("Index", "Course")">
                    <span class="sidebar-icon">&#128218;</span>Browse Courses
                </a>
                <a class="sidebar-item" href="@Url.Action("Profile", "User")">
                    <span class="sidebar-icon">&#128100;</span>Profile
                </a>
            </nav>
            <div style="position:absolute;bottom:0;left:0;right:0;padding:18px 16px;border-top:1px solid var(--border)">
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;padding:10px 8px;border-radius:10px;background:var(--surface2)">
                    <div style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,var(--gold),var(--gold2));display:flex;align-items:center;justify-content:center;color:#080a10;font-weight:800;font-size:15px;flex-shrink:0">
                        @(Session["userName"] != null ? Session["userName"].ToString()[0].ToString().ToUpper() : "U")
                    </div>
                    <div>
                        <div style="font-size:13px;font-weight:800">@Session["userName"]</div>
                        <div style="font-size:11px;color:var(--muted);font-weight:600">@role</div>
                    </div>
                </div>
                <a class="btn btn-ghost" href="@Url.Action("Logout", "Account")"
                   style="width:100%;text-align:left;font-size:13px;font-weight:700;color:var(--muted);display:block">
                    &#8592; Sign Out
                </a>
            </div>
        </aside>

        <!-- MAIN -->
        <main class="dashboard-main">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:36px">
                <div>
                    <h1 style="font-size:32px;margin-bottom:6px">Course Forums</h1>
                    <p style="color:var(--muted);font-weight:600">Discussion boards for this course</p>
                </div>
                <a href="@Url.Action("Details", "Course", new { id = courseId })" class="btn btn-ghost"> Back to Course</a>
            </div>

            @if (TempData["success"] != null)
            {
                <div style="background:rgba(45,212,191,0.1);border:1px solid rgba(45,212,191,0.3);border-radius:10px;padding:12px 16px;margin-bottom:20px;color:var(--teal);font-size:13px;font-weight:600">
                    @TempData["success"]
                </div>
            }

            @if (role == "instructor" || role == "admin")
            {
                <div style="margin-bottom:24px">
                    <a href="@Url.Action("Create", "Forum", new { courseId })" class="btn btn-primary">+ Create New Forum</a>
                </div>
            }

            @if (Model == null || Model.Count == 0)
            {
                <div style="text-align:center;padding:60px 0;color:var(--muted)">
                    <div style="font-size:48px;margin-bottom:16px">&#128172;</div>
                    <p style="font-size:16px">No forums have been created for this course yet.</p>
                    @if (role == "instructor" || role == "admin")
                    {
                        <a href="@Url.Action("Create", "Forum", new { courseId })" class="btn btn-primary" style="margin-top:16px">Create the First Forum</a>
                    }
                </div>
            }
            else
            {
                <div style="display:flex;flex-direction:column;gap:16px">
                    @foreach (var forum in Model)
                    {
                        <div class="card" style="padding:20px 24px;display:flex;justify-content:space-between;align-items:center">
                            <div>
                                <h3 style="font-size:18px;margin-bottom:6px">@forum.title</h3>
                                <p style="color:var(--muted);font-size:13px;font-weight:600">Flair: @forum.postFlair</p>
                            </div>
                            <a href="@Url.Action("Details", "Forum", new { id = forum.forumId })" class="btn btn-ghost">View Forum →</a>
                        </div>
                    }
                </div>
            }
        </main>
    </div>

</body>
</html>