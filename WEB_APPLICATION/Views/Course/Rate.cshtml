@{
    Layout = null;
    int courseId = ViewBag.CourseId != null ? (int)ViewBag.CourseId : 0;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EduNest – Rate Course</title>
    <link rel="stylesheet" href="~/Content/site.css" />
</head>
<body>

    <div class="dashboard-layout">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="sidebar-logo">
                <a class="nav-logo" href="@(Session["role"] != null && Session["role"].ToString() == "instructor" ? Url.Action("Dashboard", "Instructor") : Session["role"] != null && Session["role"].ToString() == "admin" ? Url.Action("Dashboard", "Admin") : Url.Action("MyEnrollments", "Enrollment"))" style="font-size:18px">
                    <img src="~/Uploads/logo.svg" alt="EduNest" class="nav-logo-icon" style="width:56px;height:56px" />EduNest
                </a>
            </div>
            <nav style="padding:8px 0">
                <a class="sidebar-item" href="@Url.Action("MyEnrollments", "Enrollment")">
                    <span class="sidebar-icon">&#127968;</span>Dashboard
                </a>
                <a class="sidebar-item" href="@Url.Action("Index", "Course")">
                    <span class="sidebar-icon">&#128218;</span>Browse Courses
                </a>
                <a class="sidebar-item" href="@Url.Action("Profile", "User")">
                    <span class="sidebar-icon">&#128100;</span>Profile
                </a>
            </nav>
            <div style="position:absolute;bottom:0;left:0;right:0;padding:18px 16px;border-top:1px solid var(--border)">
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;padding:10px 8px;border-radius:10px;background:var(--surface2)">
                    <div style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,var(--gold),var(--gold2));display:flex;align-items:center;justify-content:center;color:#080a10;font-weight:800;font-size:15px;flex-shrink:0">
                        @(Session["userName"] != null ? Session["userName"].ToString()[0].ToString().ToUpper() : "U")
                    </div>
                    <div>
                        <div style="font-size:13px;font-weight:800">@Session["userName"]</div>
                        <div style="font-size:11px;color:var(--muted);font-weight:600">Student</div>
                    </div>
                </div>
                <a class="btn btn-ghost" href="@Url.Action("Logout", "Account")"
                   style="width:100%;text-align:left;font-size:13px;font-weight:700;color:var(--muted);display:block">
                    &#8592; Sign Out
                </a>
            </div>
        </aside>

        <!-- MAIN -->
        <main class="dashboard-main">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:36px">
                <div>
                    <h1 style="font-size:32px;margin-bottom:6px">Rate This Course</h1>
                    <p style="color:var(--muted);font-weight:600">Share your experience with other students</p>
                </div>
                <a href="@Url.Action("Details", "Course", new { id = courseId })" class="btn btn-ghost">← Back to Course</a>
            </div>

            @if (ViewBag.Error != null)
            {
                <div style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);border-radius:10px;padding:12px 16px;margin-bottom:20px;color:#f87171;font-size:13px;font-weight:600">
                    @ViewBag.Error
                </div>
            }

            <div class="card" style="padding:36px;max-width:600px">
                <h3 style="font-weight:800;margin-bottom:24px;font-size:17px">Your Review</h3>

                @using (Html.BeginForm("Rate", "Course", FormMethod.Post))
                {
                    @Html.Hidden("courseId", courseId)

                    <div class="form-group">
                        <label class="form-label">Score <span style="color:var(--red)">*</span></label>
                        <div style="display:flex;gap:12px;margin-top:8px">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <label style="display:flex;flex-direction:column;align-items:center;gap:6px;cursor:pointer">
                                    <input type="radio" name="score" value="@i" required
                                           style="width:18px;height:18px;accent-color:var(--gold)" />
                                    <span style="font-size:22px;color:var(--gold)">★</span>
                                    <span style="font-size:12px;font-weight:700;color:var(--muted)">@i</span>
                                </label>
                            }
                        </div>
                    </div>

                    <div class="form-group" style="margin-top:24px">
                        <label class="form-label">Comment</label>
                        <textarea class="form-input" name="comment"
                                  placeholder="What did you think of this course? What did you learn?"
                                  rows="5" style="resize:vertical;min-height:120px"></textarea>
                        <small style="color:var(--muted);font-size:12px;font-weight:600">Optional but helpful for other students.</small>
                    </div>

                    <div style="display:flex;gap:12px;margin-top:8px">
                        <button type="submit" class="btn btn-primary">Submit Rating</button>
                        <a href="@Url.Action("Details", "Course", new { id = courseId })" class="btn btn-ghost">Cancel</a>
                    </div>
                }
            </div>
        </main>
    </div>

</body>
</html>
