@model List<WEB_APPLICATION.Models.Course>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EduNest - Archived Courses</title>
    <link rel="stylesheet" href="~/Content/site.css" />
</head>
<body>

    <div class="dashboard-layout">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="sidebar-logo">
                <a class="nav-logo" href="@(Session["role"] != null && Session["role"].ToString() == "instructor" ? Url.Action("Dashboard", "Instructor") : Session["role"] != null && Session["role"].ToString() == "admin" ? Url.Action("Dashboard", "Admin") : Url.Action("MyEnrollments", "Enrollment"))" style="font-size:18px">
                    <img src="~/Uploads/logo.svg" alt="EduNest" class="nav-logo-icon" style="width:56px;height:56px" />EduNest
                </a>
            </div>
            <nav style="padding:8px 0">
                <a class="sidebar-item" href="@Url.Action("Dashboard", "Instructor")">
                    <span class="sidebar-icon">&#127968;</span>Dashboard
                </a>
                <a class="sidebar-item" href="@Url.Action("Index", "Course")">
                    <span class="sidebar-icon">&#128218;</span>Browse Courses
                </a>
                <a class="sidebar-item" href="@Url.Action("Profile", "User")">
                    <span class="sidebar-icon">&#128100;</span>Profile
                </a>
            </nav>
            <div style="position:absolute;bottom:0;left:0;right:0;padding:18px 16px;border-top:1px solid var(--border)">
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;padding:10px 8px;border-radius:10px;background:var(--surface2)">
                    <div style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,var(--gold),var(--gold2));display:flex;align-items:center;justify-content:center;color:#080a10;font-weight:800;font-size:15px;flex-shrink:0">
                        @(Session["userName"] != null ? Session["userName"].ToString()[0].ToString().ToUpper() : "I")
                    </div>
                    <div>
                        <div style="font-size:13px;font-weight:800">@Session["userName"]</div>
                        <div style="font-size:11px;color:var(--muted);font-weight:600">Instructor</div>
                    </div>
                </div>
                <a class="btn btn-ghost" href="@Url.Action("Logout", "Account")"
                   style="width:100%;text-align:left;font-size:13px;font-weight:700;color:var(--muted);display:block">
                    &#8592; Sign Out
                </a>
            </div>
        </aside>

        <!-- MAIN -->
        <main class="dashboard-main">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:36px">
                <div>
                    <h1 style="font-size:32px;margin-bottom:6px">Archived Courses</h1>
                    <p style="color:var(--muted);font-weight:600">Courses That have been  archived </p>
                </div>
                <a href="@Url.Action("Dashboard", "Instructor")" class="btn btn-ghost"> Back to Dashboard</a>
            </div>

            @if (TempData["success"] != null)
            {
                <div style="background:rgba(45,212,191,0.1);border:1px solid rgba(45,212,191,0.3);border-radius:10px;padding:12px 16px;margin-bottom:20px;color:var(--teal);font-size:13px;font-weight:600">
                    @TempData["success"]
                </div>
            }

            @if (Model == null || Model.Count == 0)
            {
                <div style="text-align:center;padding:60px 0;color:var(--muted)">
                    <div style="font-size:48px;margin-bottom:16px">&#128193;</div>
                    <p style="font-size:16px">No archived courses.</p>
                </div>
            }
            else
            {
                <div class="card" style="padding:0;overflow:hidden">
                    <table style="width:100%;border-collapse:collapse">
                        <thead>
                            <tr style="border-bottom:1px solid var(--border);background:var(--surface2)">
                                <th style="padding:14px 20px;text-align:left;font-size:13px;font-weight:800;color:var(--muted)">Course</th>
                                <th style="padding:14px 20px;text-align:center;font-size:13px;font-weight:800;color:var(--muted)">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var course in Model)
                            {
                                <tr style="border-bottom:1px solid var(--border)">
                                    <td style="padding:16px 20px">
                                        <div style="font-weight:700;font-size:14px;margin-bottom:4px">@course.courseName</div>
                                        <div style="font-size:12px;color:var(--muted);max-width:400px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                                            @course.courseDescription
                                        </div>
                                    </td>
                                    <td style="padding:16px 20px;text-align:center">
                                        <div style="display:flex;gap:8px;justify-content:center">
                                            <a href="@Url.Action("Details", "Course", new { id = course.courseId })"
                                               class="btn btn-ghost" style="font-size:12px;padding:6px 12px">View</a>
                                            @using (Html.BeginForm("Reactivate", "Course", FormMethod.Post, new { style = "margin:0" }))
                                            {
                                                <input type="hidden" name="id" value="@course.courseId" />
                                                <button type="submit" class="btn btn-primary" style="font-size:12px;padding:6px 12px">
                                                    Reactivate
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </main>
    </div>

</body>
</html>
