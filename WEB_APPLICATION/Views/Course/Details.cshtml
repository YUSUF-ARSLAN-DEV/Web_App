@using System.Collections.Generic
@using System.Linq
@model WEB_APPLICATION.Models.Course

@{
    Layout = null;
    var lessons = ViewBag.Lessons as List<WEB_APPLICATION.Models.Lesson>;
    var ratings = ViewBag.Ratings as List<WEB_APPLICATION.Models.Rating>;
    var avgRating = ViewBag.AverageRating != null ? (float)ViewBag.AverageRating : 0f;
    var isEnrolled = ViewBag.IsEnrolled != null && (bool)ViewBag.IsEnrolled;
    var role = Session["role"] != null ? Session["role"].ToString() : "";
    var hasRated = ViewBag.HasRated != null && (bool)ViewBag.HasRated;
    var enrollmentId = ViewBag.EnrollmentId;
    bool isActive = Model != null && Model.activeStatus;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EduNest – @(Model != null ? Model.courseName : "Course")</title>
    <link rel="stylesheet" href="~/Content/site.css" />
</head>
<body>

    @{
        string dashboardLink = "#";
        if (role == "student") { dashboardLink = Url.Action("MyEnrollments", "Enrollment"); }
        else if (role == "instructor") { dashboardLink = Url.Action("Dashboard", "Instructor"); }
        else if (role == "admin") { dashboardLink = Url.Action("Dashboard", "Admin"); }
        else { dashboardLink = Url.Action("Index", "Home"); }
    }

    <!-- NAVIGATION -->
    <nav class="nav">
        <a class="nav-logo" href="@dashboardLink">
            <div class="nav-logo-icon"></div>EduNest
        </a>
        <div class="nav-right">
            @if (Session["userId"] != null)
            {
                <span style="color:var(--muted);font-size:14px;margin-right:12px">Hi, @Session["userName"]</span>
                <a class="btn btn-ghost" href="@Url.Action("Logout", "Account")">Log Out</a>
            }
            else
            {
                <a class="btn btn-ghost" href="@Url.Action("Login", "Account")">Log In</a>
                <a class="btn btn-primary" href="@Url.Action("Registration", "Account")">Get Started Free</a>
            }
        </div>
    </nav>

    <div style="max-width:1140px;margin:0 auto;padding:40px 48px">
        <!-- ARCHIVED BANNER (only visible to instructors/admins) -->
        @if (!isActive && (role == "instructor" || role == "admin"))
        {
            <div style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);border-radius:10px;padding:16px 20px;margin-bottom:24px;display:flex;align-items:center;justify-content:space-between">
                <div>
                    <span style="color:#f87171;font-weight:800;font-size:14px">&#128193; This course is archived</span>
                    <span style="color:var(--muted);font-size:13px;font-weight:600;margin-left:12px">Students cannot see or enroll in it.</span>
                </div>
                @if (role == "instructor" || role == "admin")
                {
                    using (Html.BeginForm("Reactivate", "Course", FormMethod.Post, new { style = "margin:0" }))
                    {
                        <input type="hidden" name="id" value="@Model.courseId" />
                        <button type="submit" class="btn btn-primary" style="font-size:13px;padding:8px 18px">Reactivate</button>
                    }
                }
            </div>
        }

        <!-- SUCCESS/ERROR MESSAGES -->
        @if (TempData["success"] != null)
        {
            <div style="background:rgba(45,212,191,0.1);border:1px solid rgba(45,212,191,0.3);border-radius:10px;padding:12px 16px;margin-bottom:20px;color:var(--teal);font-size:13px;font-weight:600">
                @TempData["success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);border-radius:10px;padding:12px 16px;margin-bottom:20px;color:#f87171;font-size:13px;font-weight:600">
                @TempData["Error"]
            </div>
        }

        <!-- MAIN CONTENT - FULL WIDTH (no sidebar for non-students) -->
        <div style="display:grid;grid-template-columns:1fr;gap:44px">

            <!-- LEFT COLUMN (Full width) -->
            <div>
                <!-- Course Title -->
                <h1 style="font-size:36px;line-height:1.2;margin-bottom:16px">@Model.courseName</h1>

                <!-- Course Description -->
                <p style="color:var(--muted);font-size:16px;margin-bottom:22px;line-height:1.75;font-weight:500">@Model.courseDescription</p>

                <!-- Rating Display -->
                @if (avgRating > 0)
                {
                    <div style="display:flex;align-items:center;gap:8px;margin-bottom:22px">
                        <strong>@Math.Round(avgRating, 1)</strong>
                        <span style="color:var(--muted);font-size:13px">/ 5 (@(ratings != null ? ratings.Count : 0) ratings)</span>
                    </div>
                }

                <!-- Course Image -->
                @if (!string.IsNullOrEmpty(Model.imageUrl))
                {
                    <div style="border-radius:16px;overflow:hidden;margin-bottom:28px;border:1px solid var(--border)">
                        <img src="@Model.imageUrl" alt="@Model.courseName" style="width:100%;height:280px;object-fit:cover;display:block" />
                    </div>
                }

                <!-- Lessons List -->
                <h2 style="font-size:22px;margin-bottom:18px">Course Lessons</h2>
                @if (lessons == null || lessons.Count == 0)
                {
                    <div style="padding:32px;text-align:center;color:var(--muted);border:1px solid var(--border);border-radius:12px">
                        No lessons added yet.
                    </div>
                }
                else
                {
                    for (int i = 0; i < lessons.Count; i++)
                    {
                        var lesson = lessons[i];
                        <div style="display:flex;align-items:center;gap:14px;padding:14px 0;border-bottom:1px solid var(--border)">
                            <span style="font-size:18px;color:var(--muted)">@(i + 1).</span>
                            <div style="flex:1">
                                <div style="font-size:14px;font-weight:600">@lesson.lessonTitle</div>
                            </div>
                            @if (isEnrolled || role == "instructor" || role == "admin")
                            {
                                <a href="@Url.Action("Details", "Lesson", new { id = lesson.lessonId })"
                                   class="btn btn-ghost" style="font-size:12px;padding:6px 14px">View</a>
                            }
                        </div>
                    }
                }

                <!-- Discussions Section -->
                @if (Session["userId"] != null)
                {
                    <div style="margin-top:36px;margin-bottom:36px">
                        <h2 style="font-size:22px;margin-bottom:18px">&#128172; Discussions</h2>
                        <div style="display:flex;align-items:center;justify-content:space-between;padding:20px 24px;border:1px solid var(--border);border-radius:12px">
                            <div>
                                <div style="font-weight:700;font-size:15px;margin-bottom:4px">Course Forums</div>
                                <div style="font-size:13px;color:var(--muted);font-weight:600">Discuss topics, ask questions, and share ideas.</div>
                            </div>
                            <a href="@Url.Action("Index", "Forum", new { courseId = Model.courseId })"
                               class="btn btn-outline" style="flex-shrink:0;margin-left:16px">View Forums</a>
                        </div>
                    </div>
                }



                <!-- Student Reviews -->
                @if (ratings != null && ratings.Count > 0)
                {
                    <h2 style="font-size:22px;margin-top:36px;margin-bottom:18px">Student Reviews</h2>
                    foreach (var rating in ratings)
                    {
                        <div style="padding:20px 0;border-bottom:1px solid var(--border)">
                            <div style="display:flex;justify-content:space-between;margin-bottom:8px">
                                <strong style="font-size:15px">Student #@rating.userId</strong>
                                <span style="color:var(--gold); font-weight:700">
                                    @rating.score/5
                                </span>
                            </div>
                            <p style="color:var(--muted);font-size:14px;font-weight:500">@rating.comment</p>
                        </div>
                    }
                }
                <!-- Enroll Button (only for students who are NOT enrolled) -->
                @if (role == "student" && !isEnrolled)
                {
                    <div style="margin-top:36px;margin-bottom:36px">
                        @using (Html.BeginForm("Enroll", "Enrollment", FormMethod.Post))
                        {
                            @Html.Hidden("courseId", Model.courseId)
                            <button type="submit" class="btn btn-primary" style="width:100%;padding:14px;font-size:16px;font-weight:700">
                                Enroll in this Course
                            </button>
                        }
                    </div>
                }
                <!-- Rate This Course Button (only for enrolled students who haven't rated) -->
                @if (role == "student" && isEnrolled && !hasRated)
                {
                    <div style="margin-top:32px">
                        <a href="@Url.Action("Rate", "Course", new { id = Model.courseId })" class="btn btn-outline">Rate this Course</a>
                    </div>
                }
            </div>
        </div>

        <!-- FOOTER -->
        <footer>
            <a class="nav-logo" href="@(role == "instructor" ? Url.Action("Dashboard", "Instructor") : role == "admin" ? Url.Action("Dashboard", "Admin") : Url.Action("MyEnrollments", "Enrollment"))">
                <div class="nav-logo-icon">&#129338;</div>EduNest
            </a>
            <p style="color:var(--muted);font-size:13px;font-weight:600">&copy; 2025 EduNest. All rights reserved.</p>
            <div style="display:flex;gap:24px">
                <span style="color:var(--muted);font-size:13px;font-weight:600">Privacy</span>
                <span style="color:var(--muted);font-size:13px;font-weight:600">Terms</span>
                <span style="color:var(--muted);font-size:13px;font-weight:600">Support</span>
            </div>
        </footer>
    </div>

</body>
</html>