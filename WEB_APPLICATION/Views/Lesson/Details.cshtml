@model WEB_APPLICATION.Models.Lesson
@{
    Layout = null;
    var assessment = ViewBag.Assessment as WEB_APPLICATION.Models.Assessment;
    bool isStudent = Session["role"] != null && Session["role"].ToString() == "student";
    bool isCompleted = isStudent && (bool)(ViewBag.IsCompleted ?? false);
    int completedCount = isStudent ? (int)(ViewBag.CompletedCount ?? 0) : 0;
    int totalLessons = isStudent ? (int)(ViewBag.TotalLessons ?? 0) : 0;
    int percent = isStudent && totalLessons > 0 ? (int)((double)completedCount / totalLessons * 100) : 0;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EduNest – @Model.lessonTitle</title>
    <link rel="stylesheet" href="~/Content/site.css" />
</head>
<body>

    <div class="dashboard-layout">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="sidebar-logo">
                <a class="nav-logo" href="@Url.Action("Index", "Home")" style="font-size:18px">
                    <div class="nav-logo-icon" style="width:28px;height:28px;font-size:14px">&#129338;</div>EduNest
                </a>
            </div>
            <nav style="padding:8px 0">
                @if (Session["role"] != null && Session["role"].ToString() == "instructor")
                {
                    <a class="sidebar-item" href="@Url.Action("Dashboard", "Instructor")">
                        <span class="sidebar-icon">&#127968;</span>Dashboard
                    </a>
                    <a class="sidebar-item" href="@Url.Action("Create", "Course")">
                        <span class="sidebar-icon">&#43;</span>Create Course
                    </a>
                }
                else
                {
                    <a class="sidebar-item" href="@Url.Action("MyEnrollments", "Enrollment")">
                        <span class="sidebar-icon">&#127968;</span>Dashboard
                    </a>
                    <a class="sidebar-item" href="@Url.Action("Index", "Course")">
                        <span class="sidebar-icon">&#128218;</span>Browse Courses
                    </a>
                }
                <a class="sidebar-item" href="@Url.Action("Profile", "User")">
                    <span class="sidebar-icon">&#128100;</span>Profile
                </a>
            </nav>
            <div style="position:absolute;bottom:0;left:0;right:0;padding:18px 16px;border-top:1px solid var(--border)">
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;padding:10px 8px;border-radius:10px;background:var(--surface2)">
                    <div style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,var(--gold),var(--gold2));display:flex;align-items:center;justify-content:center;color:#080a10;font-weight:800;font-size:15px;flex-shrink:0">
                        @(Session["userName"] != null ? Session["userName"].ToString()[0].ToString().ToUpper() : "U")
                    </div>
                    <div>
                        <div style="font-size:13px;font-weight:800">@Session["userName"]</div>
                        <div style="font-size:11px;color:var(--muted);font-weight:600">
                            @(Session["role"] != null ? Session["role"].ToString() : "")
                        </div>
                    </div>
                </div>
                <a class="btn btn-ghost" href="@Url.Action("Logout", "Account")"
                   style="width:100%;text-align:left;font-size:13px;font-weight:700;color:var(--muted);display:block">
                    &#8592; Sign Out
                </a>
            </div>
        </aside>

        <!-- MAIN -->
        <main class="dashboard-main">

            <!-- HEADER -->
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:36px">
                <div>
                    <a href="@Url.Action("Index", "Lesson", new { courseId = Model.courseId })"
                       style="color:var(--muted);font-size:13px;font-weight:600;text-decoration:none;display:inline-flex;align-items:center;gap:6px;margin-bottom:10px">
                        ← Back to Lessons
                    </a>
                    <h1 style="font-size:32px;margin-bottom:6px">@Model.lessonTitle</h1>
                </div>

                @if (Session["role"] != null && (Session["role"].ToString() == "instructor" || Session["role"].ToString() == "admin"))
                {
                    <div style="display:flex;gap:10px">
                        <a href="@Url.Action("Edit", "Lesson", new { id = Model.lessonId })"
                           class="btn btn-outline">Edit Lesson</a>

                        @using (Html.BeginForm("Delete", "Lesson", FormMethod.Post, new { style = "margin:0" }))
                        {
                            @Html.Hidden("id", Model.lessonId)
                            @Html.Hidden("courseId", Model.courseId)
                            <button type="submit" class="btn btn-ghost"
                                    style="color:var(--red)"
                                    onclick="return confirm('Delete this lesson?')">
                                Delete
                            </button>
                        }
                    </div>
                }
            </div>

            @if (TempData["success"] != null)
            {
                <div style="background:rgba(45,212,191,0.1);border:1px solid rgba(45,212,191,0.3);border-radius:10px;padding:12px 16px;margin-bottom:20px;color:var(--teal);font-size:13px;font-weight:600">
                    @TempData["success"]
                </div>
            }

            <!-- PROGRESS BAR (Students only) -->
            @if (isStudent && Session["userId"] != null && totalLessons > 0)
            {
                <div style="max-width:800px;margin-bottom:20px">
                    <div style="display:flex;justify-content:space-between;font-size:13px;font-weight:600;color:var(--muted);margin-bottom:6px">
                        <span>Course progress</span>
                        <span>@completedCount / @totalLessons lessons completed (@percent%)</span>
                    </div>
                    <div class="progress-bar" style="height:8px;background:var(--surface2);border-radius:10px;overflow:hidden">
                        <div class="progress-fill" style="width:@percent%;height:100%;background:linear-gradient(90deg,var(--gold),var(--gold2));border-radius:10px"></div>
                    </div>
                </div>
            }

            <!-- LESSON CONTENT -->
            <div class="card" style="padding:40px;max-width:800px">
                <div style="font-size:15px;line-height:1.8;color:var(--text);white-space:pre-wrap">
                    @Model.lessonContent
                </div>
            </div>

            <!-- BOTTOM NAVIGATION -->
            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:28px;max-width:800px">
                <a href="@Url.Action("Index", "Lesson", new { courseId = Model.courseId })"
                   class="btn btn-ghost">← All Lessons</a>

                <div style="display:flex;gap:12px">
                    <!-- MARK COMPLETE / COMPLETED BADGE (Students only) -->
                    @if (isStudent && Session["userId"] != null)
                    {
                        if (isCompleted)
                        {
                            <span style="display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:8px;background:rgba(45,212,191,0.1);border:1px solid rgba(45,212,191,0.3);color:var(--teal);font-size:13px;font-weight:700">
                                ✓ Completed
                            </span>
                        }
                    }

                    @if (Session["role"] != null && Session["role"].ToString() == "instructor")
                    {
                        if (assessment == null)
                        {
                            <a href="@Url.Action("Create", "Assessment", new { lessonId = Model.lessonId })"
                               class="btn btn-primary">+ Add Quiz</a>
                        }
                        else
                        {
                            <a href="@Url.Action("AddQuestion", "Assessment", new { assessmentId = assessment.assessmentId })"
                               class="btn btn-outline">+ Add Question</a>
                        }
                    }

                    @if (assessment != null)
                    {
                        <a href="@Url.Action("TakeQuiz", "Assessment", new { assessmentId = assessment.assessmentId })"
                           class="btn btn-primary">Take Quiz →</a>
                    }
                </div>
            </div>
        </main>
    </div>

</body>
</html>