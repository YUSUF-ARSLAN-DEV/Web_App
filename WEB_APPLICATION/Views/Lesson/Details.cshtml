@model WEB_APPLICATION.Models.Lesson
@{
    Layout = null;
    var assessment = ViewBag.Assessment as WEB_APPLICATION.Models.Assessment;
    string role = Session["role"] != null ? Session["role"].ToString() : "";
    bool isStudent = (role == "student");
    bool isInstructor = (role == "instructor");
    bool isAdmin = (role == "admin");
    bool canEdit = isInstructor;  // Only instructors can edit/delete lessons
    bool canTakeQuiz = (isStudent || isAdmin) && assessment != null;  // Students AND admins can take quizzes
    bool isCompleted = false;
    int completedCount = 0;
    int totalLessons = 0;
    int percent = 0;

    if (isStudent)
    {
        isCompleted = (bool)(ViewBag.IsCompleted ?? false);
        completedCount = (int)(ViewBag.CompletedCount ?? 0);
        totalLessons = (int)(ViewBag.TotalLessons ?? 0);
        percent = totalLessons > 0 ? (int)((double)completedCount / totalLessons * 100) : 0;
    }




}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EduNest – @Model.lessonTitle</title>
    <link rel="stylesheet" href="~/Content/site.css" />
</head>
<body>
    <div class="dashboard-layout">
        <!-- ================================================ -->
        <!-- SIDEBAR (Left Navigation)                        -->
        <!-- ================================================ -->
        <aside class="sidebar">
            <div class="sidebar-logo">
                <a class="nav-logo" href="@(isInstructor ? Url.Action("Dashboard", "Instructor") : isAdmin ? Url.Action("Dashboard", "Admin") : Url.Action("MyEnrollments", "Enrollment"))" style="font-size:18px">
                    <div class="nav-logo-icon" style="width:28px;height:28px;font-size:14px">&#129338;</div>EduNest
                </a>
            </div>
            <nav style="padding:8px 0">
                @if (isInstructor)
                {
                    <a class="sidebar-item" href="@Url.Action("Dashboard", "Instructor")">
                        <span class="sidebar-icon">&#127968;</span>Dashboard
                    </a>
                }
                else if (isAdmin)
                {
                    <a class="sidebar-item" href="@Url.Action("Dashboard", "Admin")">
                        <span class="sidebar-icon">&#127968;</span>Dashboard
                    </a>
                }
                else
                {
                    <a class="sidebar-item" href="@Url.Action("MyEnrollments", "Enrollment")">
                        <span class="sidebar-icon">&#127968;</span>Dashboard
                    </a>
                }

                @if (!isInstructor && !isAdmin)
                {
                    <a class="sidebar-item" href="@Url.Action("Index", "Course")">
                        <span class="sidebar-icon">&#128218;</span>Browse Courses
                    </a>
                }

                <a class="sidebar-item" href="@Url.Action("Profile", "User")">
                    <span class="sidebar-icon">&#128100;</span>Profile
                </a>
            </nav>

            <!-- User Info & Sign Out (Bottom of Sidebar) -->
            <div style="position:absolute;bottom:0;left:0;right:0;padding:18px 16px;border-top:1px solid var(--border)">
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;padding:10px 8px;border-radius:10px;background:var(--surface2)">
                    <!-- User Avatar (First Letter of Username) -->
                    <div style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,var(--gold),var(--gold2));display:flex;align-items:center;justify-content:center;color:#080a10;font-weight:800;font-size:15px;flex-shrink:0">
                        @(Session["userName"] != null ? Session["userName"].ToString()[0].ToString().ToUpper() : "U")
                    </div>
                    <div>
                        <div style="font-size:13px;font-weight:800">@Session["userName"]</div>
                        <div style="font-size:11px;color:var(--muted);font-weight:600">
                            @role
                        </div>
                    </div>
                </div>
                <a class="btn btn-ghost" href="@Url.Action("Logout", "Account")"
                   style="width:100%;text-align:left;font-size:13px;font-weight:700;color:var(--muted);display:block">
                    &#8592; Sign Out
                </a>
            </div>
        </aside>

        <!-- ================================================ -->
        <!-- MAIN CONTENT AREA                                 -->
        <!-- ================================================ -->
        <main class="dashboard-main">

            <!-- HEADER -->
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:36px">
                <div>
                    <a href="@Url.Action("Index", "Lesson", new { courseId = Model.courseId })"
                       style="color:var(--muted);font-size:13px;font-weight:600;text-decoration:none;display:inline-flex;align-items:center;gap:6px;margin-bottom:10px">
                        ← Back to Lessons
                    </a>
                    <h1 style="font-size:32px;margin-bottom:6px">@Model.lessonTitle</h1>
                </div>

                @* Only instructors can edit/delete lessons - Admins see student view *@
                @if (canEdit)
                {
                    <div style="display:flex;gap:10px">
                        <a href="@Url.Action("Edit", "Lesson", new { id = Model.lessonId })"
                           class="btn btn-outline">Edit Lesson</a>

                        @using (Html.BeginForm("Delete", "Lesson", FormMethod.Post, new { style = "margin:0" }))
                        {
                            @Html.Hidden("id", Model.lessonId)
                            @Html.Hidden("courseId", Model.courseId)
                            <button type="submit" class="btn btn-ghost"
                                    style="color:var(--red)"
                                    onclick="return confirm('Delete this lesson?')">
                                Delete
                            </button>
                        }
                    </div>
                }
            </div>

            <!-- Display Success/Error Messages -->
            @if (TempData["success"] != null)
            {
                <div style="background:rgba(45,212,191,0.1);border:1px solid rgba(45,212,191,0.3);border-radius:10px;padding:12px 16px;margin-bottom:20px;color:var(--teal);font-size:13px;font-weight:600">
                    @TempData["success"]
                </div>
            }

            @if (TempData["error"] != null)
            {
                <div style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);border-radius:10px;padding:12px 16px;margin-bottom:20px;color:#f87171;font-size:13px;font-weight:600">
                    @TempData["error"]
                </div>
            }

            <!-- ===== VIDEO EMBED (from F2) ===== -->
            @if (!string.IsNullOrEmpty(Model.videoUrl))
            {
                string rawUrl = Model.videoUrl;
                string embedUrl = rawUrl;
                if (rawUrl.Contains("youtube.com/watch"))
                {
                    string[] parts = rawUrl.Split(new[] { "v=" }, StringSplitOptions.None);
                    if (parts.Length > 1)
                    {
                        string videoId = parts[1].Contains("&") ? parts[1].Split('&')[0] : parts[1];
                        embedUrl = "https://www.youtube.com/embed/" + videoId;
                    }
                }
                else if (rawUrl.Contains("youtu.be/"))
                {
                    string[] parts = rawUrl.Split(new[] { "youtu.be/" }, StringSplitOptions.None);
                    if (parts.Length > 1)
                    {
                        string videoId = parts[1].Contains("?") ? parts[1].Split('?')[0] : parts[1];
                        embedUrl = "https://www.youtube.com/embed/" + videoId;
                    }
                }
                <div style="max-width:800px;margin-bottom:24px;position:relative;padding-bottom:56.25%;height:0;overflow:hidden;border-radius:12px">
                    <iframe src="@embedUrl"
                            style="position:absolute;top:0;left:0;width:100%;height:100%;border:0"
                            allowfullscreen="allowfullscreen"></iframe>
                </div>
            }

            <!-- ===== LESSON CONTENT ===== -->
            <div class="card" style="padding:25px;max-width:800px">
                <div style="font-size:15px;line-height:1.8;color:var(--text);white-space:pre-wrap">
                    @Model.lessonContent
                </div>
            </div>

            <!-- ===== ATTACHMENT DOWNLOAD CARD (from F3) ===== -->
            @if (!string.IsNullOrEmpty(Model.attachmentUrl))
            {
                <div class="card" style="padding:20px;max-width:800px;margin-top:20px;display:flex;align-items:center;gap:16px;">
                    <div style="font-size:32px;">📎</div>
                    <div style="flex:1;">
                        <div style="font-weight:700;margin-bottom:4px;">@Model.attachmentName</div>
                        <div style="font-size:12px;color:var(--muted);">Lesson attachment - Click download to save this file</div>
                    </div>
                    <a href="@Url.Action("DownloadAttachment", "Lesson", new { id = Model.lessonId })"
                       class="btn btn-primary"
                       style="white-space:nowrap;">
                        Download ↓
                    </a>
                </div>
            }

            <!-- ===== BOTTOM NAVIGATION ===== -->
            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:28px;max-width:800px">
                <a href="@Url.Action("Index", "Lesson", new { courseId = Model.courseId })"
                   class="btn btn-ghost">← All Lessons</a>

                <div style="display:flex;gap:12px">

                    <!-- MARK COMPLETE / COMPLETED BADGE only students who are enrolled in this course can see this -->
                    @if (isStudent && ViewBag.IsEnrolled == true && Session["userId"] != null)
                    {
                        if (isCompleted)
                        {
                            <span style="display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:8px;background:rgba(45,212,191,0.1);border:1px solid rgba(45,212,191,0.3);color:var(--teal);font-size:13px;font-weight:700">
                                ✓ Completed
                            </span>
                        }
                        else
                        {
                            using (Html.BeginForm("MarkComplete", "Lesson", FormMethod.Post, new { style = "margin:0" }))
                            {
                                @Html.Hidden("lessonId", Model.lessonId)
                                @Html.Hidden("courseId", Model.courseId)
                                <button type="submit" class="btn btn-primary">✓ Mark as Complete</button>
                            }
                        }
                    }

                    <!-- Create Quiz Button (Instructors only) -->
                    @if (isInstructor && assessment == null)
                    {
                        <a href="@Url.Action("Create", "Assessment", new { lessonId = Model.lessonId })"
                           class="btn btn-primary">+ Create Quiz</a>
                    }

                    <!-- Take Quiz Button (Students and Admins only) -->
                    @if (assessment != null && (isStudent || isAdmin))
                    {
                        <a href="@Url.Action("TakeQuiz", "Assessment", new { assessmentId = assessment.assessmentId })"
                           class="btn btn-primary">Take Quiz →</a>
                    }
                </div>
            </div>
        </main>
    </div>

</body>
</html>