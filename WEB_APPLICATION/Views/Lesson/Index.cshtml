@model List<WEB_APPLICATION.Models.Lesson>
@{
    Layout = null;
    int courseId = ViewBag.CourseId != null ? (int)ViewBag.CourseId : 0;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EduNest – Lessons</title>
    <link rel="stylesheet" href="~/Content/site.css" />
</head>
<body>

    <div class="dashboard-layout">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="sidebar-logo">
                <a class="nav-logo" href="@Url.Action("Index", "Home")" style="font-size:18px">
                    <div class="nav-logo-icon" style="width:28px;height:28px;font-size:14px">&#129338;</div>EduNest
                </a>
            </div>
            <nav style="padding:8px 0">
                <a class="sidebar-item" href="@Url.Action("Dashboard", "Instructor")">
                    <span class="sidebar-icon">&#127968;</span>Dashboard
                </a>
                <a class="sidebar-item" href="@Url.Action("Create", "Course")">
                    <span class="sidebar-icon">&#43;</span>Create Course
                </a>
                <a class="sidebar-item" href="@Url.Action("Profile", "User")">
                    <span class="sidebar-icon">&#128100;</span>Profile
                </a>
            </nav>
            <div style="position:absolute;bottom:0;left:0;right:0;padding:18px 16px;border-top:1px solid var(--border)">
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;padding:10px 8px;border-radius:10px;background:var(--surface2)">
                    <div style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,var(--gold),var(--gold2));display:flex;align-items:center;justify-content:center;color:#080a10;font-weight:800;font-size:15px;flex-shrink:0">
                        @(Session["userName"] != null ? Session["userName"].ToString()[0].ToString().ToUpper() : "I")
                    </div>
                    <div>
                        <div style="font-size:13px;font-weight:800">@Session["userName"]</div>
                        <div style="font-size:11px;color:var(--muted);font-weight:600">
                            @(Session["role"] != null ? Session["role"].ToString() : "")
                        </div>
                    </div>
                </div>
                <a class="btn btn-ghost" href="@Url.Action("Logout", "Account")"
                   style="width:100%;text-align:left;font-size:13px;font-weight:700;color:var(--muted);display:block">
                    &#8592; Sign Out
                </a>
            </div>
        </aside>

        <!-- MAIN -->
        <main class="dashboard-main">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:36px">
                <div>
                    <h1 style="font-size:32px;margin-bottom:6px">Course Lessons</h1>
                    <p style="color:var(--muted);font-weight:600">
                        @(Model != null ? Model.Count : 0) lesson(s) in this course
                    </p>
                </div>
                <div style="display:flex;gap:12px">
                    <a href="@Url.Action("Details", "Course", new { id = courseId })" class="btn btn-ghost">← Back to Course</a>
                    @if (Session["role"] != null && (Session["role"].ToString() == "instructor" || Session["role"].ToString() == "admin"))
                    {
                        <a href="@Url.Action("Create", "Lesson", new { courseId = courseId })" class="btn btn-primary">+ Add Lesson</a>
                    }
                </div>
            </div>

            @if (TempData["success"] != null)
            {
                <div style="background:rgba(45,212,191,0.1);border:1px solid rgba(45,212,191,0.3);border-radius:10px;padding:12px 16px;margin-bottom:20px;color:var(--teal);font-size:13px;font-weight:600">
                    @TempData["success"]
                </div>
            }

            @if (Model == null || Model.Count == 0)
            {
                <div style="text-align:center;padding:60px 0;color:var(--muted)">
                    <div style="font-size:48px;margin-bottom:16px">&#128218;</div>
                    <p style="font-size:16px;margin-bottom:20px">No lessons added yet.</p>
                    @if (Session["role"] != null && (Session["role"].ToString() == "instructor" || Session["role"].ToString() == "admin"))
                    {
                        <a href="@Url.Action("Create", "Lesson", new { courseId = courseId })" class="btn btn-primary">Add First Lesson</a>
                    }
                </div>
            }
            else
            {
                <div class="card" style="padding:0;overflow:hidden">
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var lesson = Model[i];
                        <div style="display:flex;align-items:center;gap:18px;padding:18px 24px;border-bottom:1px solid var(--border)">

                            <!-- Lesson number -->
                            <div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--gold),var(--gold2));display:flex;align-items:center;justify-content:center;color:#080a10;font-weight:800;font-size:14px;flex-shrink:0">
                                @(i + 1)
                            </div>

                            <!-- Lesson info -->
                            <div style="flex:1">
                                <div style="font-weight:700;font-size:15px;margin-bottom:4px">
                                    @lesson.lessonTitle
                                </div>
                                <div style="font-size:12px;color:var(--muted);font-weight:500;max-width:500px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                                    @(lesson.lessonContent != null && lesson.lessonContent.Length > 80 ? lesson.lessonContent.Substring(0, 80) + "..." : lesson.lessonContent)
                                </div>
                            </div>

                            <!-- Actions -->
                            <div style="display:flex;gap:8px;flex-shrink:0">
                                <a href="@Url.Action("Details", "Lesson", new { id = lesson.lessonId })"
                                   class="btn btn-ghost" style="font-size:12px;padding:6px 12px">View</a>

                                @if (Session["role"] != null && (Session["role"].ToString() == "instructor" || Session["role"].ToString() == "admin"))
                                {
                                    <a href="@Url.Action("Edit", "Lesson", new { id = lesson.lessonId })"
                                       class="btn btn-outline" style="font-size:12px;padding:6px 12px">Edit</a>

                                    using (Html.BeginForm("Delete", "Lesson", FormMethod.Post, new { style = "margin:0" }))
                                    {
                                        @Html.Hidden("id", lesson.lessonId)
                                        @Html.Hidden("courseId", courseId)
                                        <button type="submit" class="btn btn-ghost"
                                                style="font-size:12px;padding:6px 12px;color:var(--red)"
                                                onclick="return confirm('Delete this lesson?')">
                                            Delete
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </main>
    </div>

</body>
</html>
