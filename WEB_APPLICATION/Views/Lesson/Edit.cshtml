@model WEB_APPLICATION.Models.Lesson
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EduNest – Edit Lesson</title>
    <link rel="stylesheet" href="~/Content/site.css" />
</head>
<body>

    <div class="dashboard-layout">
        <!-- ================================================ -->
        <!-- SIDEBAR (Left Navigation)                        -->
        <!-- ================================================ -->
        <aside class="sidebar">
            <div class="sidebar-logo">
                <a class="nav-logo" href="@(Session["role"] != null && Session["role"].ToString() == "instructor" ? Url.Action("Dashboard", "Instructor") : Session["role"] != null && Session["role"].ToString() == "admin" ? Url.Action("Dashboard", "Admin") : Url.Action("MyEnrollments", "Enrollment"))" style="font-size:18px">
                    <img src="~/Uploads/logo.svg" alt="EduNest" class="nav-logo-icon" style="width:56px;height:56px" />EduNest
                </a>
            </div>
            <nav style="padding:8px 0">
                <a class="sidebar-item" href="@Url.Action("Dashboard", "Instructor")">
                    <span class="sidebar-icon">&#127968;</span>Dashboard
                </a>
                <a class="sidebar-item" href="@Url.Action("Index", "Course")">
                    <span class="sidebar-icon">&#128218;</span>Browse Courses
                </a>
                <a class="sidebar-item" href="@Url.Action("Profile", "User")">
                    <span class="sidebar-icon">&#128100;</span>Profile
                </a>
            </nav>

            <!-- User Info & Sign Out (Bottom of Sidebar) -->
            <div style="position:absolute;bottom:0;left:0;right:0;padding:18px 16px;border-top:1px solid var(--border)">
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;padding:10px 8px;border-radius:10px;background:var(--surface2)">
                    <div style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,var(--gold),var(--gold2));display:flex;align-items:center;justify-content:center;color:#080a10;font-weight:800;font-size:15px;flex-shrink:0">
                        @(Session["userName"] != null ? Session["userName"].ToString()[0].ToString().ToUpper() : "I")
                    </div>
                    <div>
                        <div style="font-size:13px;font-weight:800">@Session["userName"]</div>
                        <div style="font-size:11px;color:var(--muted);font-weight:600">Instructor</div>
                    </div>
                </div>
                <a class="btn btn-ghost" href="@Url.Action("Logout", "Account")"
                   style="width:100%;text-align:left;font-size:13px;font-weight:700;color:var(--muted);display:block">
                    &#8592; Sign Out
                </a>
            </div>
        </aside>

        <!-- ================================================ -->
        <!-- MAIN CONTENT AREA                                 -->
        <!-- ================================================ -->
        <main class="dashboard-main">
            <!-- Page Header -->
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:36px">
                <div>
                    <h1 style="font-size:32px;margin-bottom:6px">Edit Lesson</h1>
                    <p style="color:var(--muted);font-weight:600">Update your lesson content</p>
                </div>
                <a href="@Url.Action("Details", "Lesson", new { id = Model.lessonId })" class="btn btn-ghost"> Back to Lesson</a>
            </div>

            <!-- Display Error Message (if any) -->
            @if (ViewBag.Error != null)
            {
                <div style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);border-radius:10px;padding:12px 16px;margin-bottom:20px;color:#f87171;font-size:13px;font-weight:600">
                    @ViewBag.Error
                </div>
            }

            <!-- Lesson Edit Form -->
            <div class="card" style="padding:36px;max-width:700px">
                <h3 style="font-weight:800;margin-bottom:24px;font-size:17px">Lesson Information</h3>

                @* IMPORTANT: enctype="multipart/form-data" is required for file uploads *@
                @using (Html.BeginForm("Edit", "Lesson", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.Hidden("lessonId", Model.lessonId)
                    @Html.Hidden("courseId", Model.courseId)

                    <!-- ===== LESSON TITLE FIELD ===== -->
                    <div class="form-group">
                        <label class="form-label">Lesson Title <span style="color:var(--red)">*</span></label>
                        <input class="form-input" name="lessonTitle"
                               value="@Model.lessonTitle"
                               placeholder="e.g. Introduction to Cinematography" required />
                    </div>

                    <!-- ===== LESSON CONTENT FIELD ===== -->
                    <div class="form-group">
                        <label class="form-label">Lesson Content <span style="color:var(--red)">*</span></label>
                        <textarea class="form-input" name="lessonContent"
                                  rows="10" style="resize:vertical;min-height:200px" required>@Model.lessonContent</textarea>
                    </div>

                    <!-- ===== VIDEO URL FIELD (Optional - from F2) ===== -->
                    <div class="form-group">
                        <label class="form-label">Video URL <span style="color:var(--muted);font-weight:500">(optional)</span></label>
                        <input class="form-input" name="videoUrl"
                               value="@Model.videoUrl"
                               placeholder="e.g. https://www.youtube.com/watch?v=..." />
                        <small style="color:var(--muted);font-size:12px;font-weight:600">Supports YouTube links. Leave blank to remove the video.</small>
                    </div>

                    <!-- ===== CURRENT ATTACHMENT DISPLAY (NEW - from F3) ===== -->
                    if (!string.IsNullOrEmpty(Model.attachmentName))
                    {
                        <div class="form-group">
                            <label class="form-label">Current Attachment</label>
                            <div style="background:var(--surface2);padding:12px;border-radius:8px;display:flex;align-items:center;gap:12px;">
                                <span style="font-size:24px">📎</span>
                                <div style="flex:1">
                                    <div style="font-weight:600">@Model.attachmentName</div>
                                    <div style="font-size:11px;color:var(--muted);">
                                        Location: @Model.attachmentUrl
                                    </div>
                                </div>
                            </div>
                            <div style="margin-top:12px;">
                                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                                    <input type="checkbox" name="removeAttachment" value="true"
                                           style="width:18px;height:18px;cursor:pointer;" />
                                    <span style="color:var(--red);font-size:14px;">✓ Remove current attachment</span>
                                </label>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="form-group">
                            <label class="form-label">Current Attachment</label>
                            <div style="background:var(--surface2);padding:12px;border-radius:8px;color:var(--muted);">
                                No attachment currently uploaded.
                            </div>
                        </div>
                    }

                    <!-- ===== NEW FILE ATTACHMENT FIELD (NEW - from F3) ===== -->
                    <div class="form-group">
                        <label class="form-label">Upload New Attachment <span style="color:var(--muted);font-weight:500">(optional)</span></label>
                        <input type="file" name="attachment" class="form-input"
                               accept=".pdf,.docx,.doc,.ppt,.pptx" />
                        <small style="color:var(--muted);font-size:12px;font-weight:600">
                            Upload a new file to replace the existing attachment. Supports PDF, DOCX, DOC, PPT, PPTX.
                        </small>
                    </div>

                    <!-- ===== FORM BUTTONS ===== -->
                    <div style="display:flex;gap:12px;margin-top:8px">
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                        <a href="@Url.Action("Details", "Lesson", new { id = Model.lessonId })" class="btn btn-ghost">Cancel</a>
                    </div>
                }
            </div>
        </main>
    </div>

</body>
</html>