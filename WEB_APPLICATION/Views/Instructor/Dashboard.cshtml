@model List<WEB_APPLICATION.Models.InstructorCourseViewModel>
@{
    Layout = null;
    int totalStudents = 0;
    float totalRating = 0f;
    int ratedCourses = 0;
    if (Model != null)
    {
        foreach (var item in Model)
        {
            totalStudents += item.studentCount;
            if (item.avgRating > 0) { totalRating += item.avgRating; ratedCourses++; }
        }
    }
    float overallRating = ratedCourses > 0 ? totalRating / ratedCourses : 0f;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EduNest – Instructor Dashboard</title>
    <link rel="stylesheet" href="~/Content/site.css" />
    <style>
        .modal-overlay { display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:1000;align-items:center;justify-content:center; }
        .modal-overlay.open { display:flex; }
        .modal-box { background:var(--card);border:1px solid var(--border);border-radius:16px;padding:32px;max-width:420px;width:90%;text-align:center; }
        .settings-dropdown { display:none;position:absolute;right:0;top:110%;background:var(--card);border:1px solid var(--border);border-radius:10px;min-width:180px;z-index:100;padding:6px 0; }
        .settings-dropdown.open { display:block; }
        .settings-dropdown a { display:block;padding:10px 16px;font-size:13px;font-weight:700;color:var(--text);text-decoration:none; }
        .settings-dropdown a:hover { background:var(--surface2); }
    </style>
</head>
<body>

    <div class="dashboard-layout">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="sidebar-logo">
                <a class="nav-logo" href="@(Session["role"] != null && Session["role"].ToString() == "instructor" ? Url.Action("Dashboard", "Instructor") : Session["role"] != null && Session["role"].ToString() == "admin" ? Url.Action("Dashboard", "Admin") : Url.Action("MyEnrollments", "Enrollment"))" style="font-size:18px">
                    <div class="nav-logo-icon" style="width:28px;height:28px;font-size:14px">&#129338;</div>EduNest
                </a>
            </div>
            <nav style="padding:8px 0">
                <a class="sidebar-item active" href="@Url.Action("Dashboard", "Instructor")">
                    <span class="sidebar-icon">&#127968;</span>Dashboard
                </a>
                <a class="sidebar-item" href="@Url.Action("Index", "Course")">
                    <span class="sidebar-icon">&#128218;</span>Browse Courses
                </a>
                <a class="sidebar-item" href="@Url.Action("Profile", "User")">
                    <span class="sidebar-icon">&#128100;</span>Profile
                </a>
            </nav>
            <div style="position:absolute;bottom:0;left:0;right:0;padding:18px 16px;border-top:1px solid var(--border)">
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;padding:10px 8px;border-radius:10px;background:var(--surface2)">
                    <div style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,var(--gold),var(--gold2));display:flex;align-items:center;justify-content:center;color:#080a10;font-weight:800;font-size:15px;flex-shrink:0">
                        @(Session["userName"] != null ? Session["userName"].ToString()[0].ToString().ToUpper() : "I")
                    </div>
                    <div>
                        <div style="font-size:13px;font-weight:800">@Session["userName"]</div>
                        <div style="font-size:11px;color:var(--muted);font-weight:600">Instructor</div>
                    </div>
                </div>
                <a class="btn btn-ghost" href="@Url.Action("Logout", "Account")"
                   style="width:100%;text-align:left;font-size:13px;font-weight:700;color:var(--muted);display:block">
                    &#8592; Sign Out
                </a>
            </div>
        </aside>

        <!-- MAIN -->
        <main class="dashboard-main">

            <!-- HEADER -->
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:36px">
                <div>
                    <h1 style="font-size:32px;margin-bottom:6px">
                        Welcome back, @Session["firstName"] &#128075;
                    </h1>
                    <p style="color:var(--muted);font-weight:600">
                        @if (Model != null && Model.Count > 0)
                        {
                            <text>You have @Model.Count active course(s). Keep creating!</text>
                        }
                        else
                        {
                            <text>You have no active courses yet. Create your first one!</text>
                        }
                    </p>
                </div>
                <div style="display:flex;gap:10px;align-items:center">
                    <a class="btn btn-primary" href="@Url.Action("Create", "Course")">+ New Course</a>
                    <div style="position:relative">
                        <button onclick="toggleSettings()" class="btn btn-ghost" style="font-size:18px;padding:8px 12px">&#8943;</button>
                        <div class="settings-dropdown" id="settingsDropdown">
                            <a href="@Url.Action("ArchivedCourses", "Course")">&#128193; Archived Courses</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- STATS -->
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-bottom:36px">
                <div class="stat-card">
                    <div class="stat-value">@(Model != null ? Model.Count : 0)</div>
                    <div class="stat-label">Active Courses</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value">@totalStudents</div>
                    <div class="stat-label">Total Students</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value">
                        @if (overallRating > 0)
                        {
                            @(Math.Round(overallRating, 1) + " ★")
                        }
                        else
                        {
                            <text>N/A</text>
                        }
                    </div>
                    <div class="stat-label">Avg. Rating</div>
                </div>
            </div>

            @if (TempData["success"] != null)
            {
                <div style="background:rgba(45,212,191,0.1);border:1px solid rgba(45,212,191,0.3);border-radius:10px;padding:12px 16px;margin-bottom:20px;color:var(--teal);font-size:13px;font-weight:600">
                    @TempData["success"]
                </div>
            }

            <!-- COURSES TABLE -->
            <h2 style="font-size:24px;margin-bottom:20px">My Courses</h2>

            @if (Model == null || Model.Count == 0)
            {
                <div style="text-align:center;padding:60px 0;color:var(--muted)">
                    <div style="font-size:48px;margin-bottom:16px">&#128218;</div>
                    <p style="font-size:16px;margin-bottom:20px">You haven't created any courses yet.</p>
                    <a href="@Url.Action("Create", "Course")" class="btn btn-primary">Create Your First Course</a>
                </div>
            }
            else
            {
                <div class="card" style="padding:0;overflow:hidden">
                    <table style="width:100%;border-collapse:collapse">
                        <thead>
                            <tr style="border-bottom:1px solid var(--border);background:var(--surface2)">
                                <th style="padding:14px 20px;text-align:left;font-size:13px;font-weight:800;color:var(--muted)">Course</th>
                                <th style="padding:14px 20px;text-align:center;font-size:13px;font-weight:800;color:var(--muted)">Lessons</th>
                                <th style="padding:14px 20px;text-align:center;font-size:13px;font-weight:800;color:var(--muted)">Students</th>
                                <th style="padding:14px 20px;text-align:center;font-size:13px;font-weight:800;color:var(--muted)">Rating</th>
                                <th style="padding:14px 20px;text-align:center;font-size:13px;font-weight:800;color:var(--muted)">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr style="border-bottom:1px solid var(--border)">
                                    <td style="padding:16px 20px">
                                        <div style="font-weight:700;font-size:14px;margin-bottom:4px">@item.course.courseName</div>
                                        <div style="font-size:12px;color:var(--muted);font-weight:500;max-width:280px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                                            @item.course.courseDescription
                                        </div>
                                    </td>
                                    <td style="padding:16px 20px;text-align:center;font-weight:700">@item.lessonCount</td>
                                    <td style="padding:16px 20px;text-align:center;font-weight:700">@item.studentCount</td>
                                    <td style="padding:16px 20px;text-align:center">
                                        @if (item.avgRating > 0)
                                        {
                                            <span style="color:var(--gold);font-weight:700">@Math.Round(item.avgRating, 1) ★</span>
                                        }
                                        else
                                        {
                                            <span style="color:var(--muted);font-weight:600">No ratings</span>
                                        }
                                    </td>
                                    <td style="padding:16px 20px;text-align:center">
                                        <div style="display:flex;gap:8px;justify-content:center">
                                            <a href="@Url.Action("Details", "Course", new { id = item.course.courseId })"
                                               class="btn btn-ghost" style="font-size:12px;padding:6px 12px">View</a>
                                            <a href="@Url.Action("Edit", "Course", new { id = item.course.courseId })"
                                               class="btn btn-outline" style="font-size:12px;padding:6px 12px">Edit</a>
                                            <button type="button" class="btn btn-ghost"
                                                    style="font-size:12px;padding:6px 12px;color:var(--red)"
                                                    onclick="openDeleteModal(@item.course.courseId, '@Html.Raw(item.course.courseName.Replace("'", "\\'"))')">
                                                Archive
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </main>
    </div>

    <!-- DELETE / ARCHIVE MODAL -->
    <div class="modal-overlay" id="deleteModal">
        <div class="modal-box">
            <div style="font-size:40px;margin-bottom:16px">&#128193;</div>
            <h2 style="font-size:20px;font-weight:800;margin-bottom:10px">Archive this course?</h2>
            <p style="color:var(--muted);font-size:14px;font-weight:600;margin-bottom:24px" id="modalCourseName"></p>
            <p style="color:var(--muted);font-size:13px;margin-bottom:28px">
                The course will be hidden from students. You can reactivate it anytime from Archived Courses.
            </p>
            <div style="display:flex;gap:12px;justify-content:center">
                <button onclick="closeDeleteModal()" class="btn btn-ghost" style="padding:10px 24px">Cancel</button>
                <form id="deleteForm" method="post" style="margin:0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteCourseId" />
                    <button type="submit" class="btn btn-primary" style="padding:10px 24px;background:var(--red);border-color:var(--red)">
                        Archive
                    </button>
                </form>
            </div>
        </div>
    </div>

    <script>
        function openDeleteModal(courseId, courseName) {
            document.getElementById('deleteCourseId').value = courseId;
            document.getElementById('modalCourseName').textContent = '"' + courseName + '"';
            document.getElementById('deleteForm').action = '@Url.Action("Delete", "Course")';
            document.getElementById('deleteModal').classList.add('open');
        }
        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.remove('open');
        }
        function toggleSettings() {
            document.getElementById('settingsDropdown').classList.toggle('open');
        }
        document.addEventListener('click', function(e) {
            var dd = document.getElementById('settingsDropdown');
            if (!e.target.closest('[onclick="toggleSettings()"]') && !e.target.closest('#settingsDropdown')) {
                dd.classList.remove('open');
            }
        });
    </script>

</body>
</html>
