@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EduNest – Change Password</title>
    <link rel="stylesheet" href="~/Content/site.css" />
</head>
<body>

    <div class="dashboard-layout">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="sidebar-logo">
                <a class="nav-logo" href="@(Session["role"] != null && Session["role"].ToString() == "instructor" ? Url.Action("Dashboard", "Instructor") : Session["role"] != null && Session["role"].ToString() == "admin" ? Url.Action("Dashboard", "Admin") : Url.Action("MyEnrollments", "Enrollment"))" style="font-size:18px">
                    <img src="~/Uploads/logo.svg" alt="EduNest" class="nav-logo-icon" style="width:56px;height:56px" />EduNest
                </a>
            </div>
            <nav style="padding:8px 0">
                <a class="sidebar-item" href="@Url.Action("MyEnrollments", "Enrollment")">
                    <span class="sidebar-icon">&#127968;</span>Dashboard
                </a>
                <a class="sidebar-item" href="@Url.Action("Index", "Course")">
                    <span class="sidebar-icon">&#128218;</span>Browse Courses
                </a>
                <a class="sidebar-item active" href="@Url.Action("Profile", "User")">
                    <span class="sidebar-icon">&#128100;</span>Profile
                </a>
            </nav>
            <div style="position:absolute;bottom:0;left:0;right:0;padding:18px 16px;border-top:1px solid var(--border)">
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;padding:10px 8px;border-radius:10px;background:var(--surface2)">
                    <div style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,var(--gold),var(--gold2));display:flex;align-items:center;justify-content:center;color:#080a10;font-weight:800;font-size:15px;flex-shrink:0">
                        @(Session["userName"] != null ? Session["userName"].ToString()[0].ToString().ToUpper() : "U")
                    </div>
                    <div>
                        <div style="font-size:13px;font-weight:800">@Session["userName"]</div>
                        <div style="font-size:11px;color:var(--muted);font-weight:600">@Session["role"]</div>
                    </div>
                </div>
                <a class="btn btn-ghost" href="@Url.Action("Logout", "Account")"
                   style="width:100%;text-align:left;font-size:13px;font-weight:700;color:var(--muted);display:block">
                    &#8592; Sign Out
                </a>
            </div>
        </aside>

        <!-- MAIN -->
        <main class="dashboard-main">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:36px">
                <div>
                    <h1 style="font-size:32px;margin-bottom:6px">Change Password</h1>
                    <p style="color:var(--muted);font-weight:600">Keep your account secure</p>
                </div>
                <a href="@Url.Action("Profile", "User")" class="btn btn-ghost">← Back to Profile</a>
            </div>

            @if (ViewBag.Error != null)
            {
                <div style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);border-radius:10px;padding:12px 16px;margin-bottom:20px;color:#f87171;font-size:13px;font-weight:600">
                    @ViewBag.Error
                </div>
            }

            @if (TempData["success"] != null)
            {
                <div style="background:rgba(45,212,191,0.1);border:1px solid rgba(45,212,191,0.3);border-radius:10px;padding:12px 16px;margin-bottom:20px;color:var(--teal);font-size:13px;font-weight:600">
                    @TempData["success"]
                </div>
            }

            <div class="card" style="padding:36px;max-width:500px">
                <h3 style="font-weight:800;margin-bottom:24px;font-size:17px">Update Password</h3>

                @using (Html.BeginForm("ChangePassword", "User", FormMethod.Post))
                {
                    <div class="form-group">
                        <label class="form-label">Current Password</label>
                        <input class="form-input" type="password" name="currentPassword"
                               placeholder="Enter current password" required />
                    </div>

                    <div class="form-group">
                        <label class="form-label">New Password</label>
                        <input class="form-input" type="password" name="newPassword"
                               placeholder="Enter new password" required />
                        <small style="color:var(--muted);font-size:12px;font-weight:600">
                            Must contain uppercase, lowercase, and a number.
                        </small>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Confirm New Password</label>
                        <input class="form-input" type="password" name="confirmPassword"
                               placeholder="Confirm new password" required />
                    </div>

                    <div style="display:flex;gap:12px;margin-top:8px">
                        <button type="submit" class="btn btn-primary">Update Password</button>
                        <a href="@Url.Action("Profile", "User")" class="btn btn-ghost">Cancel</a>
                    </div>
                }
            </div>
        </main>
    </div>

</body>
</html>
