@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EduNest - Complete Your Profile</title>
    <link rel="stylesheet" href="~/Content/site.css" />
    <style>
        .role-card {
            flex: 1;
            border: 2px solid var(--border);
            border-radius: 16px;
            padding: 24px 20px;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            background: var(--surface2);
            transition: border-color 0.2s, background 0.2s;
        }
        .role-card input[type="radio"] { display: none; }
        .role-card:has(input:checked) {
            border-color: var(--gold);
            background: rgba(201,168,76,0.08);
        }
        .role-card:hover { border-color: rgba(201,168,76,0.5); }
        .role-icon { font-size: 36px; }
        .role-title { font-weight: 800; font-size: 16px; }
        .role-sub { font-size: 13px; color: var(--muted); font-weight: 500; text-align: center; }
    </style>
</head>
<body>

    <div style="display:flex;min-height:100vh">

        <!-- LEFT PANEL -->
        <div style="flex:1;position:relative;overflow:hidden">
            <img src="https://images.unsplash.com/photo-1434030216411-0b793f4b4173?w=800&q=80" alt="Learning"
                 style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover">
            <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(8,10,16,0.92),rgba(8,10,16,0.75))"></div>
            <div style="position:relative;display:flex;flex-direction:column;justify-content:center;height:100%;padding:64px">
                <a class="nav-logo" href="@Url.Action("Index", "Home")" style="font-size:28px">
                    <img src="~/Uploads/logo.svg" alt="EduNest" class="nav-logo-icon" style="width:56px;height:56px" />EduNest
                </a>
                <div style="margin-top:52px">
                    <div style="font-size:52px;margin-bottom:20px">&#127881;</div>
                    <h2 style="font-size:36px;margin-bottom:16px;line-height:1.25">
                        One last<br><span style="color:var(--gold);font-style:italic">step.</span>
                    </h2>
                    <p style="color:var(--muted);font-size:15px;max-width:360px;line-height:1.75;font-weight:500">
                        Your Google account is verified. Just tell us how you'll be using EduNest.
                    </p>
                </div>
            </div>
        </div>

        <!-- RIGHT PANEL -->
        <div style="width:500px;display:flex;flex-direction:column;justify-content:center;padding:64px 52px;background:var(--bg)">
            <h2 style="font-size:28px;margin-bottom:6px">
                Hi, @ViewBag.FirstName! &#128075;
            </h2>
            <p style="color:var(--muted);margin-bottom:32px;font-size:14px;font-weight:600">
                Signed in as <span style="color:var(--gold)">@ViewBag.Email</span>
            </p>

            @if (ViewBag.Error != null)
            {
                <div style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);border-radius:10px;padding:12px 16px;margin-bottom:20px;color:#f87171;font-size:13px;font-weight:600">
                    @ViewBag.Error
                </div>
            }

            <p style="font-size:15px;font-weight:700;margin-bottom:20px">How will you use EduNest?</p>

            @using (Html.BeginForm("CompleteGoogleProfile", "Account", FormMethod.Post))
            {
                <div style="display:flex;gap:16px;margin-bottom:32px">
                    <label class="role-card" id="card-student">
                        <input type="radio" name="role" value="student" checked />
                        <div class="role-icon">&#127891;</div>
                        <div class="role-title">Student</div>
                        <div class="role-sub">I want to enroll in courses and learn new skills</div>
                    </label>
                    <label class="role-card" id="card-instructor">
                        <input type="radio" name="role" value="instructor" />
                        <div class="role-icon">&#129489;</div>
                        <div class="role-title">Instructor</div>
                        <div class="role-sub">I want to create and publish courses for learners</div>
                    </label>
                </div>

                <button type="submit" class="btn btn-primary btn-lg btn-block" style="width:100%">
                    Join EduNest 
                </button>
            }

            <p style="color:var(--muted);font-size:12px;text-align:center;margin-top:20px;font-weight:600">
                You can always update your profile later.
            </p>
        </div>
    </div>

  

</body>
</html>
