@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EduNest – Create Account</title>
    <link rel="stylesheet" href="~/Content/site.css" />
</head>
<body>

    <div style="display:flex;min-height:100vh">

        <!-- LEFT PANEL -->
        <div style="flex:1;position:relative;overflow:hidden">
            <img src="https://images.unsplash.com/photo-1606761568499-6d2451b23c66?w=800&q=80" alt="Certificate"
                 style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover">
            <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(8,10,16,0.94),rgba(8,10,16,0.72))"></div>
            <div style="position:relative;display:flex;flex-direction:column;justify-content:center;height:100%;padding:64px">
                <a class="nav-logo" href="@Url.Action("Index", "Home")" style="font-size:28px">
                    <div class="nav-logo-icon" style="width:44px;height:44px;font-size:22px">&#129338;</div>EduNest
                </a>
                <div style="margin-top:52px">
                    <h2 style="font-size:38px;margin-bottom:16px;line-height:1.2">
                        Start your journey<br><span style="color:var(--gold);font-style:italic">today.</span>
                    </h2>
                    <p style="color:var(--muted);font-size:15px;max-width:360px;line-height:1.75;font-weight:500">
                        Create your free account and start learning 
                    </p>
                </div>
                <div style="margin-top:52px;display:flex;flex-direction:column;gap:16px">
  
                </div>
            </div>
        </div>

        <!-- RIGHT PANEL -->
        <div style="width:520px;display:flex;flex-direction:column;justify-content:center;padding:64px 52px;background:var(--bg)">
            <h2 style="font-size:30px;margin-bottom:6px">Create your account</h2>
            <p style="color:var(--muted);margin-bottom:30px;font-size:14px;font-weight:600">
                Already have one? <a href="@Url.Action("Login", "Account")" style="color:var(--gold);text-decoration:none">Log in</a>
            </p>

            @* Error message *@
            @if (ViewBag.Error != null)
            {
                <div style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);border-radius:10px;padding:12px 16px;margin-bottom:20px;color:#f87171;font-size:13px;font-weight:600">
                    @ViewBag.Error
                </div>
            }

            @* Success message *@
            @if (TempData["success"] != null)
            {
                <div style="background:rgba(45,212,191,0.1);border:1px solid rgba(45,212,191,0.3);border-radius:10px;padding:12px 16px;margin-bottom:20px;color:var(--teal);font-size:13px;font-weight:600">
                    @TempData["success"]
                </div>
            }

            @using (Html.BeginForm("Registration", "Account", FormMethod.Post))
            {
                <div class="form-group">
                    <label class="form-label">First Name</label>
                    <input class="form-input" name="firstName" placeholder="Jane" required />
                </div>

                <div class="form-group">
                    <label class="form-label">Last Name</label>
                    <input class="form-input" name="lastName" placeholder="Doe" required />
                </div>

                <div class="form-group">
                    <label class="form-label">Username</label>
                    <input class="form-input" name="userName" placeholder="janedoe123" required />
                    <small style="color:var(--muted);font-size:12px;font-weight:600">4-20 characters, letters/numbers/underscores only. Cannot start with a digit.</small>
                </div>

                <div class="form-group">
                    <label class="form-label">Password</label>
                    <input class="form-input" type="password" name="password" placeholder="Min. 8 characters" required />
                    <small style="color:var(--muted);font-size:12px;font-weight:600">Must contain uppercase, lowercase, and a number.</small>
                </div>

                <div class="form-group">
                    <label class="form-label">I am a...</label>
                    <div style="display:flex;gap:16px;margin-top:8px">
                        <label style="flex:1;border:1.5px solid var(--border);border-radius:12px;padding:16px;cursor:pointer;display:flex;align-items:center;gap:12px;background:var(--surface2)">
                            <input type="radio" name="role" value="student" checked style="accent-color:var(--gold)" />
                            <div>
                                <div style="font-weight:800;font-size:14px">&#127891; Student</div>
                                <div style="font-size:12px;color:var(--muted);font-weight:500">I want to learn</div>
                            </div>
                        </label>
                        <label style="flex:1;border:1.5px solid var(--border);border-radius:12px;padding:16px;cursor:pointer;display:flex;align-items:center;gap:12px;background:var(--surface2)">
                            <input type="radio" name="role" value="instructor" style="accent-color:var(--gold)" />
                            <div>
                                <div style="font-weight:800;font-size:14px">&#129489; Instructor</div>
                                <div style="font-size:12px;color:var(--muted);font-weight:500">I want to teach</div>
                            </div>
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-lg btn-block" style="width:100%;margin-top:8px">
                    Create Account →
                </button>
            }

            <p style="color:var(--muted);font-size:12px;margin-top:20px;text-align:center;font-weight:500">
                By creating an account you agree to our
                <span style="color:var(--gold);cursor:pointer">Terms of Service</span> and
                <span style="color:var(--gold);cursor:pointer">Privacy Policy</span>.
            </p>
        </div>
    </div>

</body>
</html>
