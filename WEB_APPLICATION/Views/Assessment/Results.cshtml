@model WEB_APPLICATION.Models.Assessment
@{
    Layout = null;
    int score = ViewBag.Score != null ? (int)ViewBag.Score : 0;
    int total = ViewBag.Total != null ? (int)ViewBag.Total : 0;
    float percentage = total > 0 ? ((float)score / total) * 100 : 0f;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EduNest – Quiz Results</title>
    <link rel="stylesheet" href="~/Content/site.css" />
</head>
<body>

    <div class="dashboard-layout">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="sidebar-logo">
                <a class="nav-logo" href="@(Session["role"] != null && Session["role"].ToString() == "instructor" ? Url.Action("Dashboard", "Instructor") : Session["role"] != null && Session["role"].ToString() == "admin" ? Url.Action("Dashboard", "Admin") : Url.Action("MyEnrollments", "Enrollment"))" style="font-size:18px">
                    <img src="~/Uploads/logo.svg" alt="EduNest" class="nav-logo-icon" style="width:56px;height:56px" />EduNest
                </a>
            </div>
            <nav style="padding:8px 0">
                <a class="sidebar-item" href="@Url.Action("MyEnrollments", "Enrollment")">
                    <span class="sidebar-icon">&#127968;</span>Dashboard
                </a>
                <a class="sidebar-item" href="@Url.Action("Index", "Course")">
                    <span class="sidebar-icon">&#128218;</span>Browse Courses
                </a>
                <a class="sidebar-item" href="@Url.Action("Profile", "User")">
                    <span class="sidebar-icon">&#128100;</span>Profile
                </a>
            </nav>
            <div style="position:absolute;bottom:0;left:0;right:0;padding:18px 16px;border-top:1px solid var(--border)">
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;padding:10px 8px;border-radius:10px;background:var(--surface2)">
                    <div style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,var(--gold),var(--gold2));display:flex;align-items:center;justify-content:center;color:#080a10;font-weight:800;font-size:15px;flex-shrink:0">
                        @(Session["userName"] != null ? Session["userName"].ToString()[0].ToString().ToUpper() : "U")
                    </div>
                    <div>
                        <div style="font-size:13px;font-weight:800">@Session["userName"]</div>
                        <div style="font-size:11px;color:var(--muted);font-weight:600">@Session["role"]</div>
                    </div>
                </div>
                <a class="btn btn-ghost" href="@Url.Action("Logout", "Account")"
                   style="width:100%;text-align:left;font-size:13px;font-weight:700;color:var(--muted);display:block">
                    &#8592; Sign Out
                </a>
            </div>
        </aside>

        <!-- MAIN -->
        <main class="dashboard-main" style="display:flex;align-items:center;justify-content:center">
            <div style="max-width:560px;width:100%;text-align:center">

                <!-- Icon -->
                <div style="font-size:64px;margin-bottom:20px">
                    @if (percentage >= 80)
                    {
                        <text>&#127881;</text>
                    }
                    else if (percentage >= 50)
                    {
                        <text>&#128079;</text>
                    }
                    else
                    {
                        <text>&#128214;</text>
                    }
                </div>

                <h1 style="font-size:32px;margin-bottom:8px">Quiz Complete!</h1>

                <p style="color:var(--muted);font-weight:600;margin-bottom:32px">
                    @if (percentage >= 80)
                    {
                        <text>Excellent work! Keep it up.</text>
                    }
                    else if (percentage >= 50)
                    {
                        <text>Good effort! Review the lesson and try again.</text>
                    }
                    else
                    {
                        <text>Keep studying! You can do better.</text>
                    }
                </p>

                <!-- Score card -->
                <div class="card" style="padding:36px;margin-bottom:28px">
                    <div style="font-size:13px;font-weight:700;color:var(--muted);letter-spacing:0.05em;margin-bottom:12px">
                        YOUR SCORE
                    </div>

                    @if (ViewBag.Score == null)
                    {
                        <div style="font-size:48px;font-weight:800;color:var(--muted);margin-bottom:8px">—</div>
                        <p style="color:var(--muted);font-size:13px;font-weight:600">
                            Score unavailable. You may have refreshed the page.
                        </p>
                    }
                    else
                    {
                        <div style="font-size:64px;font-weight:800;color:var(--gold);margin-bottom:8px">
                            @score / @total
                        </div>
                        <div style="font-size:22px;font-weight:700;color:var(--muted)">
                            @Math.Round(percentage, 0)%
                        </div>
                    }
                </div>

                <!-- Actions -->
                <div style="display:flex;gap:12px;justify-content:center">
                    <a href="@Url.Action("Details", "Lesson", new { id = Model.lessonId })"
                       class="btn btn-ghost"> Back to Lesson</a>
                    <a href="@Url.Action("MyEnrollments", "Enrollment")"
                       class="btn btn-primary">Go to Dashboard</a>
                </div>
            </div>
        </main>
    </div>

</body>
</html>
