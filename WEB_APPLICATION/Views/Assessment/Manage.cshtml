@{
    Layout = null;
    var lesson = ViewBag.Lesson as WEB_APPLICATION.Models.Lesson;
    var assessment = ViewBag.Assessment as WEB_APPLICATION.Models.Assessment;
    var questions = ViewBag.Questions as List<WEB_APPLICATION.Models.Question>;
    string role = Session["role"] != null ? Session["role"].ToString() : "";
}

@functions {
    string GetQuestionTypeDisplay(string type)
    {
        if (type == "multiple_choice") return "Multiple Choice";
        if (type == "true_false") return "True/False";
        if (type == "short_answer") return "Short Answer";
        return type;
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EduNest – Manage Quiz</title>
    <link rel="stylesheet" href="~/Content/site.css" />
</head>
<body>

    <div class="dashboard-layout">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="sidebar-logo">
                <a class="nav-logo" href="@(role == "instructor" ? Url.Action("Dashboard", "Instructor") : Url.Action("Dashboard", "Admin"))" style="font-size:18px">
                    <div class="nav-logo-icon" style="width:28px;height:28px;font-size:14px">&#129338;</div>EduNest
                </a>
            </div>
            <nav style="padding:8px 0">
                <a class="sidebar-item" href="@Url.Action("Dashboard", "Instructor")">
                    <span class="sidebar-icon">&#127968;</span>Dashboard
                </a>
                <a class="sidebar-item" href="@Url.Action("Profile", "User")">
                    <span class="sidebar-icon">&#128100;</span>Profile
                </a>
            </nav>
            <div style="position:absolute;bottom:0;left:0;right:0;padding:18px 16px;border-top:1px solid var(--border)">
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;padding:10px 8px;border-radius:10px;background:var(--surface2)">
                    <div style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,var(--gold),var(--gold2));display:flex;align-items:center;justify-content:center;color:#080a10;font-weight:800;font-size:15px;flex-shrink:0">
                        @(Session["userName"] != null ? Session["userName"].ToString()[0].ToString().ToUpper() : "I")
                    </div>
                    <div>
                        <div style="font-size:13px;font-weight:800">@Session["userName"]</div>
                        <div style="font-size:11px;color:var(--muted);font-weight:600">@role</div>
                    </div>
                </div>
                <a class="btn btn-ghost" href="@Url.Action("Logout", "Account")"
                   style="width:100%;text-align:left;font-size:13px;font-weight:700;color:var(--muted);display:block">
                    &#8592; Sign Out
                </a>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="dashboard-main">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:36px">
                <div>
                    <h1 style="font-size:32px;margin-bottom:6px">Manage Quiz</h1>
                    <p style="color:var(--muted);font-weight:600">
                        Lesson: <strong>@lesson.lessonTitle</strong>
                    </p>
                </div>
                <a href="@Url.Action("Index", "Lesson", new { courseId = lesson.courseId })" class="btn btn-ghost">← Back to Lessons</a>
            </div>

            @if (TempData["success"] != null)
            {
                <div style="background:rgba(45,212,191,0.1);border:1px solid rgba(45,212,191,0.3);border-radius:10px;padding:12px 16px;margin-bottom:20px;color:var(--teal);font-size:13px;font-weight:600">
                    @TempData["success"]
                </div>
            }

            @if (TempData["error"] != null)
            {
                <div style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);border-radius:10px;padding:12px 16px;margin-bottom:20px;color:#f87171;font-size:13px;font-weight:600">
                    @TempData["error"]
                </div>
            }

            <!-- CASE 1: NO QUIZ EXISTS -->
            @if (assessment == null)
            {
                <div class="card" style="padding:60px;text-align:center">
                    <div style="font-size:48px;margin-bottom:16px">📝</div>
                    <h2 style="font-size:20px;margin-bottom:10px">No Quiz Created Yet</h2>
                    <p style="color:var(--muted);margin-bottom:24px">This lesson doesn't have a quiz. Create one to test your students!</p>
                    <a href="@Url.Action("Create", "Assessment", new { lessonId = lesson.lessonId })" class="btn btn-primary">
                        + Create Quiz
                    </a>
                </div>
            }
            else
            {
                <!-- CASE 2: QUIZ EXISTS -->
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
                    <h2 style="font-size:22px">Quiz Questions</h2>
                    <a href="@Url.Action("AddQuestion", "Assessment", new { assessmentId = assessment.assessmentId })" class="btn btn-primary">
                        + Add Question
                    </a>
                </div>

                if (questions == null || questions.Count == 0)
                {
                    <div class="card" style="padding:40px;text-align:center">
                        <p style="color:var(--muted)">No questions added yet.</p>
                        <a href="@Url.Action("AddQuestion", "Assessment", new { assessmentId = assessment.assessmentId })" class="btn btn-primary" style="margin-top:16px">
                            Add First Question
                        </a>
                    </div>
                }
                else
                {
                    <div class="card" style="padding:0;overflow:hidden">
                        <table style="width:100%;border-collapse:collapse">
                            <thead>
                                <tr style="background:var(--surface2);border-bottom:1px solid var(--border)">
                                    <th style="padding:14px 20px;text-align:left">Question</th>
                                    <th style="padding:14px 20px;text-align:center">Type</th>
                                    <th style="padding:14px 20px;text-align:center">Correct Answer</th>
                                    <th style="padding:14px 20px;text-align:center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var q in questions)
                                {
                                    <tr style="border-bottom:1px solid var(--border)">
                                        <td style="padding:14px 20px">
                                            <div style="font-weight:600">@q.questionText</div>
                                        </td>
                                        <td style="padding:14px 20px;text-align:center">
                                            <span style="background:rgba(45,212,191,0.1);padding:4px 12px;border-radius:20px;font-size:12px">
                                                @GetQuestionTypeDisplay(q.questionType)
                                            </span>
                                        </td>
                                        <td style="padding:14px 20px;text-align:center">
                                            <span style="color:var(--gold);font-weight:600">@q.correctAnswer</span>
                                        </td>
                                        <td style="padding:14px 20px;text-align:center">
                                            <div style="display:flex;gap:8px;justify-content:center">
                                                <a href="@Url.Action("EditQuestion", "Assessment", new { questionId = q.questionId })" class="btn btn-ghost" style="font-size:12px;padding:4px 12px">Edit</a>
                                                @using (Html.BeginForm("DeleteQuestion", "Assessment", FormMethod.Post, new { style = "margin:0" }))
                                                {
                                                    @Html.Hidden("questionId", q.questionId)
                                                    @Html.Hidden("assessmentId", assessment.assessmentId)
                                                    <button type="submit" class="btn btn-ghost" style="font-size:12px;padding:4px 12px;color:var(--red)" onclick="return confirm('Delete this question?')">
                                                        Delete
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <!-- DELETE ENTIRE QUIZ SECTION -->
                <div style="margin-top:32px;border-top:1px solid var(--border);padding-top:24px">
                    @using (Html.BeginForm("DeleteAssessment", "Assessment", FormMethod.Post, new { style = "margin:0" }))
                    {
                        @Html.Hidden("id", assessment.assessmentId)
                        @Html.Hidden("lessonId", lesson.lessonId)
                        <button type="submit" class="btn btn-ghost" style="color:var(--red)" onclick="return confirm('Delete this entire quiz and all questions? This cannot be undone.')">
                            🗑️ Delete Entire Quiz
                        </button>
                    }
                </div>
            }
        </main>
    </div>

</body>
</html>