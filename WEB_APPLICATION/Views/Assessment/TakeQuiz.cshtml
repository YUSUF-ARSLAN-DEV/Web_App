@model WEB_APPLICATION.Models.Assessment
@{
    Layout = null;
    var questions = ViewBag.Questions as List<WEB_APPLICATION.Models.Question>;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EduNest - Take Quiz</title>
    <link rel="stylesheet" href="~/Content/site.css" />
</head>
<body>

    <div class="dashboard-layout">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="sidebar-logo">
                <a class="nav-logo" href="@(Session["role"] != null && Session["role"].ToString() == "instructor" ? Url.Action("Dashboard", "Instructor") : Session["role"] != null && Session["role"].ToString() == "admin" ? Url.Action("Dashboard", "Admin") : Url.Action("MyEnrollments", "Enrollment"))" style="font-size:18px">
                    <img src="~/Uploads/logo.svg" alt="EduNest" class="nav-logo-icon" style="width:56px;height:56px" />EduNest
                </a>
            </div>
            <nav style="padding:8px 0">
                <a class="sidebar-item" href="@Url.Action("MyEnrollments", "Enrollment")">
                    <span class="sidebar-icon">&#127968;</span>Dashboard
                </a>
                <a class="sidebar-item" href="@Url.Action("Index", "Course")">
                    <span class="sidebar-icon">&#128218;</span>Browse Courses
                </a>
                <a class="sidebar-item" href="@Url.Action("Profile", "User")">
                    <span class="sidebar-icon">&#128100;</span>Profile
                </a>
            </nav>
            <div style="position:absolute;bottom:0;left:0;right:0;padding:18px 16px;border-top:1px solid var(--border)">
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;padding:10px 8px;border-radius:10px;background:var(--surface2)">
                    <div style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,var(--gold),var(--gold2));display:flex;align-items:center;justify-content:center;color:#080a10;font-weight:800;font-size:15px;flex-shrink:0">
                        @(Session["userName"] != null ? Session["userName"].ToString()[0].ToString().ToUpper() : "U")
                    </div>
                    <div>
                        <div style="font-size:13px;font-weight:800">@Session["userName"]</div>
                        <div style="font-size:11px;color:var(--muted);font-weight:600">@Session["role"]</div>
                    </div>
                </div>
                <a class="btn btn-ghost" href="@Url.Action("Logout", "Account")"
                   style="width:100%;text-align:left;font-size:13px;font-weight:700;color:var(--muted);display:block">
                    &#8592; Sign Out
                </a>
            </div>
        </aside>

        <!-- MAIN -->
        <main class="dashboard-main">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:36px">
                <div>
                    <h1 style="font-size:32px;margin-bottom:6px">Quiz</h1>
                    <p style="color:var(--muted);font-weight:600">
                        @(questions != null ? questions.Count : 0) question(s) — answer all before submitting
                    </p>
                </div>
                <a href="@Url.Action("Details", "Lesson", new { id = Model.lessonId })" class="btn btn-ghost">Back to Lesson</a>
            </div>

            @if (questions == null || questions.Count == 0)
            {
                <div style="text-align:center;padding:60px 0;color:var(--muted)">
                    <div style="font-size:48px;margin-bottom:16px">&#128221;</div>
                    <p style="font-size:16px">No questions have been added to this quiz yet.</p>
                </div>
            }
            else
            {
                using (Html.BeginForm("SubmitQuiz", "Assessment", FormMethod.Post))
                {
                    @Html.Hidden("assessmentId", Model.assessmentId)

                    for (int i = 0; i < questions.Count; i++)
                    {
                        var q = questions[i];
                        <div class="card" style="padding:28px;margin-bottom:18px">
                            <div style="font-size:13px;font-weight:700;color:var(--muted);margin-bottom:10px">
                                QUESTION @(i + 1) OF @questions.Count
                            </div>
                            <p style="font-size:16px;font-weight:700;margin-bottom:20px;line-height:1.5">
                                @q.questionText
                            </p>

                            @if (q.questionType == "true_false")
                            {
                                <div style="display:flex;flex-direction:column;gap:10px">
                                    <label style="display:flex;align-items:center;gap:12px;padding:14px 18px;border:1px solid var(--border);border-radius:10px;cursor:pointer;font-weight:600">
                                        <input type="radio" name="q_@q.questionId" value="True" required /> True
                                    </label>
                                    <label style="display:flex;align-items:center;gap:12px;padding:14px 18px;border:1px solid var(--border);border-radius:10px;cursor:pointer;font-weight:600">
                                        <input type="radio" name="q_@q.questionId" value="False" /> False
                                    </label>
                                </div>
                            }
                            else if (q.questionType == "short_answer")
                            {
                                <input class="form-input" type="text"
                                       name="q_@q.questionId"
                                       placeholder="Type your answer here..." required />
                            }
                            else
                            {
                                <!-- multiple_choice — render radio buttons from pipe-separated options -->
                                if (!string.IsNullOrEmpty(q.questionAnswer))
                                {
                                    string[] opts = q.questionAnswer.Split('|');
                                    string[] labels = { "A", "B", "C", "D" };
                                    <div style="display:flex;flex-direction:column;gap:10px">
                                    @for (int j = 0; j < opts.Length; j++)
                                    {
                                        string optVal = opts[j].Trim();
                                        string optLabel = j < labels.Length ? labels[j] : (j + 1).ToString();
                                        <label style="display:flex;align-items:center;gap:12px;padding:14px 18px;border:1px solid var(--border);border-radius:10px;cursor:pointer;font-weight:600">
                                            <input type="radio" name="q_@q.questionId" value="@optVal" @(j == 0 ? "required" : "") />
                                            <span style="color:var(--muted);font-weight:800;min-width:20px">@optLabel</span>
                                            @optVal
                                        </label>
                                    }
                                    </div>
                                }
                                else
                                {
                                    <input class="form-input" type="text"
                                           name="q_@q.questionId"
                                           placeholder="Type your answer here..." required />
                                }
                            }
                        </div>
                    }

                    <div style="display:flex;justify-content:flex-end;margin-top:8px">
                        <button type="submit" class="btn btn-primary" style="padding:14px 36px;font-size:15px">
                            Submit Quiz
                        </button>
                    </div>
                }
            }
        </main>
    </div>

</body>
</html>
