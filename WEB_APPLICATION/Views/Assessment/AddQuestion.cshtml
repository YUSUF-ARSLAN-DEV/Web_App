@{
    Layout = null;
    int assessmentId = ViewBag.AssessmentId != null ? (int)ViewBag.AssessmentId : 0;
    int lessonId = ViewBag.LessonId != null ? (int)ViewBag.LessonId : 0;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EduNest – Add Question</title>
    <link rel="stylesheet" href="~/Content/site.css" />
</head>
<body>

    <div class="dashboard-layout">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="sidebar-logo">
                <a class="nav-logo" href="@(Session["role"] != null && Session["role"].ToString() == "instructor" ? Url.Action("Dashboard", "Instructor") : Session["role"] != null && Session["role"].ToString() == "admin" ? Url.Action("Dashboard", "Admin") : Url.Action("MyEnrollments", "Enrollment"))" style="font-size:18px">
                    <img src="~/Uploads/logo.svg" alt="EduNest" class="nav-logo-icon" style="width:56px;height:56px" />EduNest
                </a>
            </div>
            <nav style="padding:8px 0">
                <a class="sidebar-item" href="@Url.Action("Dashboard", "Instructor")">
                    <span class="sidebar-icon">&#127968;</span>Dashboard
                </a>
                <a class="sidebar-item" href="@Url.Action("Index", "Course")">
                    <span class="sidebar-icon">&#128218;</span>Browse Courses
                </a>
                <a class="sidebar-item" href="@Url.Action("Profile", "User")">
                    <span class="sidebar-icon">&#128100;</span>Profile
                </a>
            </nav>
            <div style="position:absolute;bottom:0;left:0;right:0;padding:18px 16px;border-top:1px solid var(--border)">
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;padding:10px 8px;border-radius:10px;background:var(--surface2)">
                    <div style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,var(--gold),var(--gold2));display:flex;align-items:center;justify-content:center;color:#080a10;font-weight:800;font-size:15px;flex-shrink:0">
                        @(Session["userName"] != null ? Session["userName"].ToString()[0].ToString().ToUpper() : "I")
                    </div>
                    <div>
                        <div style="font-size:13px;font-weight:800">@Session["userName"]</div>
                        <div style="font-size:11px;color:var(--muted);font-weight:600">Instructor</div>
                    </div>
                </div>
                <a class="btn btn-ghost" href="@Url.Action("Logout", "Account")"
                   style="width:100%;text-align:left;font-size:13px;font-weight:700;color:var(--muted);display:block">
                    &#8592; Sign Out
                </a>
            </div>
        </aside>

        <!-- MAIN -->
        <main class="dashboard-main">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:36px">
                <div>
                    <h1 style="font-size:32px;margin-bottom:6px">Add Question</h1>
                    <p style="color:var(--muted);font-weight:600">Add questions to your quiz one at a time</p>
                </div>
                @if (lessonId > 0)
                {
                    <a href="@Url.Action("Details", "Lesson", new { id = lessonId })" class="btn btn-ghost">Back to Lesson</a>
                }
                </div>

            @if (TempData["success"] != null)
            {
                <div style="background:rgba(45,212,191,0.1);border:1px solid rgba(45,212,191,0.3);border-radius:10px;padding:12px 16px;margin-bottom:20px;color:var(--teal);font-size:13px;font-weight:600">
                    @TempData["success"]
                </div>
            }
            @if (ViewBag.Error != null)
            {
                <div style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);border-radius:10px;padding:12px 16px;margin-bottom:20px;color:#f87171;font-size:13px;font-weight:600">
                    @ViewBag.Error
                </div>
            }

            <div class="card" style="padding:36px;max-width:700px">
                <h3 style="font-weight:800;margin-bottom:24px;font-size:17px">Question Details</h3>

                <form id="questionForm" method="post" action="@Url.Action("AddQuestion", "Assessment")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="assessmentId" value="@assessmentId" />
                    <input type="hidden" name="correctAnswer" id="correctAnswerHidden" />
                    <input type="hidden" name="questionAnswer" id="questionAnswerHidden" />

                    <!-- Question Type -->
                    <div class="form-group">
                        <label class="form-label">Question Type <span style="color:var(--red)">*</span></label>
                        <select class="form-input" id="questionType" name="questionType" required>
                            <option value="" disabled selected>Select question type...</option>
                            <option value="multiple_choice">Multiple Choice</option>
                            <option value="true_false">True / False</option>
                            <option value="short_answer">Short Answer</option>
                        </select>
                    </div>

                    <!-- Question Text -->
                    <div class="form-group">
                        <label class="form-label">Question Text <span style="color:var(--red)">*</span></label>
                        <textarea class="form-input" name="questionText"
                                  placeholder="e.g. Which of the following is a storage device?"
                                  rows="4" style="resize:vertical" required></textarea>
                    </div>

                    <!-- MCQ OPTIONS -->
                    <div id="mcqSection" style="display:none">
                        <div class="form-group">
                            <label class="form-label">Answer Options <span style="color:var(--red)">*</span></label>
                            <div style="display:flex;flex-direction:column;gap:10px">
                                <div style="display:flex;align-items:center;gap:10px">
                                    <span style="font-weight:700;width:20px">A</span>
                                    <input class="form-input" id="optA" placeholder="Option A" style="flex:1" />
                                </div>
                                <div style="display:flex;align-items:center;gap:10px">
                                    <span style="font-weight:700;width:20px">B</span>
                                    <input class="form-input" id="optB" placeholder="Option B" style="flex:1" />
                                </div>
                                <div style="display:flex;align-items:center;gap:10px">
                                    <span style="font-weight:700;width:20px">C</span>
                                    <input class="form-input" id="optC" placeholder="Option C" style="flex:1" />
                                </div>
                                <div style="display:flex;align-items:center;gap:10px">
                                    <span style="font-weight:700;width:20px">D</span>
                                    <input class="form-input" id="optD" placeholder="Option D" style="flex:1" />
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Correct Option <span style="color:var(--red)">*</span></label>
                            <select class="form-input" id="mcqCorrect">
                                <option value="">Select correct answer...</option>
                                <option value="A">A</option>
                                <option value="B">B</option>
                                <option value="C">C</option>
                                <option value="D">D</option>
                            </select>
                        </div>
                    </div>

                    <!-- TRUE/FALSE SECTION -->
                    <div id="tfSection" style="display:none">
                        <div class="form-group">
                            <label class="form-label">Correct Answer <span style="color:var(--red)">*</span></label>
                            <select class="form-input" id="tfCorrect">
                                <option value="">Select correct answer...</option>
                                <option value="True">True</option>
                                <option value="False">False</option>
                            </select>
                        </div>
                    </div>

                    <!-- SHORT ANSWER SECTION -->
                    <div id="saSection" style="display:none">
                        <div class="form-group">
                            <label class="form-label">Correct Answer <span style="color:var(--red)">*</span></label>
                            <input class="form-input" id="saCorrect" placeholder="e.g. photosynthesis" />
                            <small style="color:var(--muted);font-size:12px;font-weight:600">The exact answer students must match.</small>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Accepted Keywords <span style="color:var(--muted);font-weight:500">(optional)</span></label>
                            <input class="form-input" id="saKeywords" placeholder="e.g. photosynthesis|chlorophyll|light" />
                            <small style="color:var(--muted);font-size:12px;font-weight:600">Pipe-separated alternative words that also count as correct.</small>
                        </div>
                    </div>

                    <div style="display:flex;gap:12px;margin-top:8px">
                        <button type="submit" class="btn btn-primary">Add Question</button>
                        @if (lessonId > 0)
                        {
                            <a href="@Url.Action("Details", "Lesson", new { id = lessonId })" class="btn btn-ghost">Done</a>
                        }
                    </div>
                </form>
            </div>
        </main>
    </div>

</body>
</html>
